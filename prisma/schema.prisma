// BahiKhata Pro — India's Best Ledger App
// Database schema for shop owners: products, parties, transactions, GST, etc.
// Multi-tenant: every model has userId for data isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Pooled connection (with -pooler) for runtime queries
  directUrl = env("DIRECT_URL") // Direct connection (no -pooler) for migrations
}

// ==================== USERS (Authentication) ====================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String // hashed with bcrypt
  phone         String? // for future phone OTP
  emailVerified DateTime? // for future email verification
  image         String? // profile picture URL
  role          String    @default("owner") // owner | staff
  ownerId       String? // if staff, links to the owner's account
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Staff permissions — JSON object controlling which modules staff can access.
  permissions Json?

  // Subscription / plan
  cancelledAt DateTime?
  plan        String    @default("free") // free | pro | elite
  renewsAt    DateTime?
  trialEndsAt DateTime?

  // 🔒 SECURITY (Audit fix Phase 3.3): tokenVersion for JWT revocation.
  // Incrementing this invalidates ALL existing JWTs for this user (logout all
  // devices, force re-login after password change, kill stolen sessions).
  // The JWT callback in auth.ts compares the token's tokenVersion claim
  // against this DB value on every request — if they differ, the session
  // is treated as invalid.
  tokenVersion Int @default(0)

  // Relations
  products            Product[]
  parties             Party[]
  transactions        Transaction[]
  billShares          BillShare[]
  payments            Payment[]
  settings            Setting[]
  auditLogs           AuditLog[]
  fieldChangeLogs     FieldChangeLog[]
  gstReturns          GstReturn[]
  gstr1Snapshots      Gstr1Snapshot[]
  gstr2bImports       Gstr2bImport[]
  bankStatements      BankStatement[]
  bankTransactions    BankTransaction[]
  referralsMade       Referral[]        @relation("Referral_referrerIdToUser")
  referralReceived    Referral?         @relation("Referral_referredIdToUser")
  subscriptions       Subscription[]
  usageTracking       UsageTracking[]
  shops               Shop[]
  scanComparisons     ScanComparison[]
  aiUsageLogs         AiUsageLog[]
  supportTickets      SupportTicket[]
  npsFeedback         NpsFeedback[]
  invoiceCounter      InvoiceCounter?
  // 🔒 V13 L4: Back-relation for createdByUserId on Transaction
  transactionsCreated Transaction[]     @relation("TransactionCreatedBy")
  // 🔒 V22-14 (Batch D, Phase 7g): Document Vault
  documents           Document[]

  @@index([plan])
  @@index([createdAt])
  @@index([updatedAt])
}

// ==================== SHOPS (Multi-shop support) ====================
// Each owner can have multiple shops. Products, transactions, parties
// can be tagged with a shopId. When null, shows in all shops (backward compatible).
model Shop {
  id        String   @id @default(cuid())
  userId    String // owner of this shop
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // e.g. "Sharma Kirana Store"
  gstin     String?
  address   String?
  phone     String?
  state     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================== PRODUCTS / INVENTORY ====================
model Product {
  id                String   @id @default(cuid())
  userId            String // owner of this product
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId            String? // multi-shop: null = all shops (backward compatible)
  name              String
  sku               String?
  /**
   * The manufacturer's barcode (EAN-13, UPC-A, …) — NOT the same thing as sku.
   * sku is the shop's own code, typed by the shopkeeper ("ATA001"). barcode is
   * printed on the packet by whoever made it, and is what the camera reads.
   * Before this column the app had a working scanner and nowhere to put what it
   * scanned: ProductPicker and Inventory both matched on `p.barcode`, a field
   * that did not exist, so every scan silently matched nothing. Storing the EAN
   * in sku was the only workaround, and it costs the shopkeeper their own code.
   * Nullable, and deliberately NOT unique: loose goods have no barcode, and two
   * rows can legitimately carry the same one (a 500g and a 1kg pack of the same
   * brand sometimes share a code, and re-used codes exist in the wild). Matching
   * takes the first hit rather than promising there is only one.
   */
  barcode           String?
  hsn               String? // HSN/SAC code for GST
  category          String?
  unit              String   @default("pcs") // pcs, kg, ltr, m, box
  purchasePrice     Int      @default(0) // price at which shop owner buys
  salePrice         Int      @default(0) // price at which shop owner sells
  mrp               Int? // MRP printed on product
  gstRate           Float    @default(0) // 0, 5, 12, 18, 28
  // 🔒 V12: When true, salePrice/mrp are INCLUSIVE of GST (the Indian retail
  // norm — MRP is legally GST-inclusive). The sale flow then back-calculates
  // taxable value = price × 100/(100+rate) instead of adding GST on top.
  // Default false = old behaviour (price is taxable value, GST added on top).
  priceIncludesGst  Boolean  @default(false)
  /**
   * False for a SERVICE — something sold without a countable stock of it.
   *
   * Was: every row was stock-tracked, unconditionally. A tailor selling
   * "Blouse stitching", a salon selling "Haircut", a photographer selling
   * "Wedding shoot" all start at currentStock = 0, and the default stock
   * policy is 'block' — so the FIRST sale they ever try to make is refused
   * with "Not enough stock — record a purchase or enable overselling in
   * Settings". There is no purchase to record. The only escape was to turn
   * off overselling protection for the whole shop, which is exactly the
   * guard a shop that ALSO sells goods needs to keep.
   *
   * Nothing about a service has a stock level, so nothing about it should be
   * counted, warned about, valued, or reported as low. `tracksStock()` in
   * lib/inventory-tracking.ts is the single predicate; every stock read and
   * write goes through it, and a guard test fails the build if a new one
   * does not.
   *
   * Default TRUE so every existing row keeps today's behaviour exactly.
   * New products default from the HSN/SAC code (99xx ⇒ service) but the
   * shopkeeper can always override — the code is a hint, not the truth.
   */
  tracksInventory   Boolean  @default(true)
  openingStock      Float    @default(0)
  // 🔒 AUDIT FIX H1: Authoritative stock count, maintained transactionally.
  // Was: stock computed at read time (openingStock + purchases - sales) — no
  // guard against overselling, no concurrency control.
  // Now: currentStock is the cached running balance, updated atomically inside
  // the same $transaction as the sale/purchase. On sale: decrement. On purchase:
  // increment. The dashboard reads this directly (no JS recompute).
  currentStock      Float    @default(0)
  lowStockThreshold Float    @default(5)
  notes             String?
  // 🔒 V17 Audit §4.2: GST treatment — distinguishes nil-rated (0% GST but
  // taxable supply), exempt (no GST, not taxable), non-GST (outside GST scope),
  // and taxable (default). Used by GSTR-3B 3.1(c) to properly break out
  // nil-rated vs exempt vs non-GST outward supplies. Before this, exemptValue
  // was hardcoded to 0 because there was no way to mark a product as exempt.
  gstTreatment      String   @default("taxable") // taxable | nil | exempt | nonGst
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactionItems TransactionItem[]

  // Unique SKU per user (not globally)
  @@unique([userId, sku])
  // Performance: list products per user, search by name within user
  @@index([userId, name])
  // Scan lookup: exact code within a shop. Mirrors the partial index created in
  // migration 20260807000001 (Prisma cannot express the WHERE clause).
  @@index([userId, barcode])
  @@index([userId, category])
  @@index([userId, shopId])
}

// ==================== PARTIES (Customers & Suppliers) ====================
model Party {
  id             String    @id @default(cuid())
  userId         String // owner of this party
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId         String? // multi-shop: null = all shops (backward compatible)
  name           String
  type           String    @default("customer") // customer | supplier | both
  phone          String?
  email          String?
  gstin          String? // GST Identification Number
  address        String?
  state          String? // for intra/inter state GST
  openingBalance Int       @default(0) // positive = they owe us; negative = we owe them
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // 🔒 AUDIT FIX M7: Soft delete (same as Transaction)
  deletedAt      DateTime?

  transactions Transaction[]
  payments     Payment[]

  // 🔒 V11 §2.2: Indexes — was ZERO indexes, caused full-table scans on every
  // Parties page load and every dashboard load (the receivable/payable query
  // joins Party to Transaction with WHERE p."userId" = ...). At scale this
  // gets linearly slower as the Party table grows across all tenants.
  // Now: two composite indexes matching the actual query patterns.
  @@index([userId, deletedAt]) // list page + join filter (most common query)
  @@index([userId, name]) // list page orders by name
  // V17-Ext Tier 3: GSTIN lookup for GSTR-2B reconciliation (fast supplier matching)
  @@index([userId, gstin])
}

// ==================== TRANSACTIONS (Sales, Purchases, Income, Expense) ====================
model Transaction {
  id              String   @id @default(cuid())
  userId          String // owner of this transaction
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId          String? // multi-shop: null = all shops (backward compatible)
  invoiceNo       String? // bill/invoice number from bill (user-provided OR auto-generated)
  // 🔒 AUDIT FIX M6: Sequential invoice number per user (GST compliance).
  // Auto-generated when the user doesn't provide one. Unique per user so
  // no two transactions share the same invoice number.
  invoiceSequence Int? // auto-incremented per user (1, 2, 3, ...)
  type            String // sale | purchase | income | expense
  partyId         String? // customer for sale, supplier for purchase
  party           Party?   @relation(fields: [partyId], references: [id])
  date            DateTime @default(now())
  subtotal        Int      @default(0) // before tax & discount
  discountAmount  Int      @default(0)
  cgst            Int      @default(0)
  sgst            Int      @default(0)
  igst            Int      @default(0)
  totalAmount     Int      @default(0) // final payable (after round-off)
  // 🔒 V12: Invoice round-off. Indian invoices customarily round the grand
  // total to the nearest rupee with an explicit "Round off" line. This stores
  // the adjustment (e.g. -0.40 or +0.30) so totalAmount == taxable + tax + roundOff
  // and the printed invoice can show it. 0 when round-off is disabled.
  roundOff        Int      @default(0)
  paidAmount      Int      @default(0) // amount actually paid
  paymentMode     String   @default("cash") // cash | upi | card | bank | credit
  isInterState    Boolean  @default(false)
  // V17-Ext Tier 3: Reverse Charge Mechanism (RCM). When true on a purchase,
  // the buyer (shopkeeper) pays GST directly to the government instead of the
  // supplier charging it. Common for: GTA (transport), legal services,
  // unregistered purchases. Affects GSTR-3B sections 3.1(d) + 4(b).
  isReverseCharge Boolean  @default(false)
  notes           String?
  // For income/expense (no items)
  category        String? // e.g. rent, salary, electricity for expenses; commission etc for income
  // Payee info for income/expense (who you paid or received from)
  payeeName       String? // name of person you paid / received from
  payeePhone      String? // mobile number of payee
  // 🔒 V13 L4: Staff accountability — records which user (owner or staff)
  // created this transaction. Null for transactions created before this
  // field was added. Used for audit trail and fraud investigation in
  // multi-user shops. Set automatically from the session in POST handler.
  createdByUserId String?
  createdBy       User?    @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 🔒 IDEMPOTENCY (Audit fix N1): client-generated UUID to prevent duplicate
  // transactions from offline sync replays. When the offline queue replays a
  // mutation that already went through, the server sees the same
  // clientMutationId and returns the existing transaction instead of creating
  // a duplicate. Same pattern as payment idempotency (Phase 1.4).
  clientMutationId String? @unique

  items TransactionItem[]

  // Auto-computed gross profit when type=sale
  grossProfit Int @default(0)

  // 🔒 AUDIT FIX M7: Soft delete for ledger integrity. Was: hard DELETE
  // (permanent, no audit trail). Now: set deletedAt = now() instead of
  // deleting the row. Queries filter WHERE deletedAt IS NULL. This preserves
  // the audit trail (required for GST/tax disputes) and allows "undo delete".
  deletedAt DateTime?

  // V17-Ext Tier 3: Credit/Debit Notes — link to original invoice
  originalTransactionId   String?
  originalTransaction     Transaction?      @relation("TransactionReversal", fields: [originalTransactionId], references: [id], onDelete: SetNull)
  reversalTransactions    Transaction[]     @relation("TransactionReversal")
  // 🔒 V17 Audit Phase 6: Bank reconciliation — matched bank transactions
  matchedBankTransactions BankTransaction[] @relation("BankReconMatch")

  // 🔒 AUDIT C5: payments settled against this bill. The bill's true due is
  // totalAmount − paidAmount − Σ(paymentAllocations.amount).
  paymentAllocations PaymentAllocation[]
  billShares         BillShare[]
  noteType           String? // 'C' (credit) or 'D' (debit) — only for credit-note/debit-note types
  noteReason         String? // GST reason: 'post-sale-discount' | 'deficiency' | 'return' | 'price-revision' | 'other'
  affectsStock       Boolean             @default(false) // true only when goods are physically returned

  // 🔒 V17 Audit Phase 5: e-Invoicing (IRN/QR) + e-Way Bill fields
  // IRN = Invoice Reference Number (64-char hash, issued by NIC portal)
  // signedQR = Signed QR code string (returned by NIC, contains invoice summary)
  // ewayBillNo = e-Way Bill number (for inter-state movement of goods > ₹50,000)
  // ewayBillExpiry = e-Way Bill expiry date (valid for ~3 days for <100km, 1 day per 200km)
  // ewayBillDate = e-Way Bill generation date
  // irnStatus = 'pending' | 'generated' | 'cancelled' (tracks IRN lifecycle)
  // irnGeneratedAt = when the IRN was generated (for audit)
  irn            String? // 64-char alphanumeric IRN from NIC
  signedQR       String? // signed QR code string from NIC
  irnStatus      String? // pending | generated | cancelled
  irnGeneratedAt DateTime?
  ewayBillNo     String? // 12-digit e-Way Bill number
  ewayBillExpiry DateTime?
  ewayBillDate   DateTime?

  // 🔒 V26 F1 FIX: Estimate conversion tracking. When an estimate is converted
  // to a sale, this field stores the sale's transaction ID. Prevents unlimited
  // re-conversion (double billing, double stock decrement). Null = not converted.
  convertedToTransactionId String?
  convertedAt              DateTime?
  /**
   * Why input credit on this purchase cannot be claimed — NULL means it can.
   * Section 17(5) blocks credit on specific things however genuine the business
   * purpose: motor vehicles carrying people, food and staff welfare, works
   * contract and construction of premises, goods given away or lost, and
   * anything bought for personal use. GSTR-3B claimed credit on every purchase
   * in the books, so a shop buying a car or a staff lunch was told it could
   * claim tax the law refuses — under-paying, with interest running under
   * Section 50 until a notice arrives.
   * A REASON rather than a boolean. "Blocked" alone tells a CA nothing at
   * assessment time, and the shopkeeper who marked it will not remember why in
   * eighteen months. The reason is the audit trail.
   * Values: personal | staffWelfare | motorVehicle | construction | lostOrFree
   * | compositionSupplier | other
   */
  itcBlockedReason         String?

  // 🔒 M6: Unique invoice number per user (GST compliance — no duplicates)
  @@unique([userId, invoiceNo])
  // Performance: list transactions per user filtered by date and/or type
  // Used by: dashboard, ledger (sales/purchases), reports
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, partyId])
  @@index([originalTransactionId])
}

model TransactionItem {
  id                  String      @id @default(cuid())
  transactionId       String
  transaction         Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id])
  productName         String // snapshot of name at time of transaction
  quantity            Float       @default(1)
  // 🔒 V12: Snapshot of the unit at time of transaction (kg, gm, ltr, pcs, ...).
  // Was: unit was dropped on save — every historical line was ambiguous
  // ("500 of Tomato" — grams? kilos?). For product-linked lines the server
  // normalizes (quantity, unit) into the product's unit before saving, so
  // quantity × unitPrice is always internally consistent.
  unit                String      @default("pcs")
  unitPrice           Int         @default(0) // price per `unit` (sale or purchase)
  // 🔒 AUDIT FIX M4: Snapshot of purchasePrice at time of sale (COGS).
  // Was: profit calculated from the product's CURRENT purchasePrice —
  // changing it later distorted historical profit. Now: the purchase price
  // is snapshotted here at sale time, so historical profit is immutable.
  purchasePriceAtSale Int         @default(0) // cost at time of sale (for profit calc)
  gstRate             Float       @default(0)
  /**
   * GST treatment snapshotted at sale time, like hsn and purchasePriceAtSale.
   * taxable | nil | exempt | nonGst — the same four values as Product.gstTreatment.
   * GSTR-1 Table 8 and GSTR-3B 3.1(c)/(e) report nil-rated, exempt and non-GST
   * supplies in SEPARATE boxes; they are different things in law. buildNIL had
   * to put every 0% line into nil_amt because the treatment never reached it,
   * so expt_amt and ngsup_amt were structurally always zero — most of a
   * kirana's zero-tax stock (fresh milk, unbranded rice and flour) is EXEMPT,
   * not nil-rated, and was being reported in the wrong box.
   * A SNAPSHOT, not a join: reclassifying a product next year must not rewrite
   * a return already filed under the old treatment. Same reasoning as hsn.
   * Nullable: rows written before this column existed have no answer, and
   * inventing one would be worse than leaving it. buildNIL falls back to the
   * old rate-based behaviour when it is absent.
   */
  gstTreatment        String?
  discountAmount      Int         @default(0) // 🔒 V10 §2.1: per-item discount (proportional share of order-level discount)
  // 🔒 V10 §2.2: per-item GST components — SINGLE SOURCE OF TRUTH for GST.
  // Was: only Transaction header stored cgst/sgst/igst; reports/GSTR recomputed
  // in SQL using a different rounding path → drift between stored and report.
  // Now: every code path (POST, PUT, reports, GSTR, dashboard, invoice PDF)
  // aggregates these stored per-item values. The GST on a transaction is the
  // sum of these three columns across all its items — never recomputed.
  cgst                Int         @default(0)
  sgst                Int         @default(0)
  igst                Int         @default(0)
  // 🔒 V17 Audit Phase 3 (GSTR-1): CESS amount (rare for kirana but portal requires the field).
  csamt               Int         @default(0)
  // 🔒 V17 Audit Phase 3 (GSTR-1): HSN snapshot at time of transaction.
  // Was: only Product.hsn existed. But HSN can change when the user edits the product,
  // and historical GSTR-1 returns must show the HSN that was in effect at sale time.
  // Now: snapshot at write time (like purchasePriceAtSale). Backfilled from Product.hsn.
  hsn                 String?
  total               Int         @default(0) // taxable + cgst + sgst + igst + csamt

  // 🔒 V17 Audit Phase 10: Snapshot of the user's ORIGINAL entered quantity + unit
  // (before normalization). The stored `quantity`/`unit` are the NORMALIZED values
  // (e.g., 500ml → 0.5ltr). This snapshot preserves what the user actually typed
  // so credit notes can load the original intent (500ml, not 0.5ltr).
  enteredQuantity Float? // original quantity as entered by the user
  enteredUnit     String? // original unit as entered by the user (ml, gm, etc.)

  createdAt DateTime @default(now())

  // ⚡ PERFORMANCE (Audit fix Phase 5): Indexes on foreign keys.
  // Without these, every `include: { items: true }` on Transaction does a
  // FULL TABLE SCAN on TransactionItem. With the index, it's an instant
  // index lookup. This is the #1 missing index in the schema.
  @@index([transactionId])
  @@index([productId])
}

// ==================== PAYMENTS (udhaar settlement — V13 H3) ====================
// 🔒 V13 H3: The Payment model is now ACTIVE (was dead weight before H3).
// Used by:
//   - POST /api/payments — record a receive/pay against a party
//   - GET /api/payments?partyId=xxx — list payments for a party
//   - party-balance.ts — included in balance calculation
//   - PartyProfile.tsx — "Settle" button + Payment History card
model Payment {
  id               String    @id @default(cuid())
  userId           String // owner of this payment
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partyId          String
  party            Party     @relation(fields: [partyId], references: [id])
  amount           Int
  date             DateTime  @default(now())
  mode             String    @default("cash") // cash | upi | card | bank
  type             String    @default("received") // received (from customer) | paid (to supplier)
  notes            String?
  createdAt        DateTime  @default(now())
  // 🔒 V15 M-3: Soft-delete so deleted receipts stay auditable (disputes / fraud).
  // Hard-deleting a payment silently changes historical balances — exactly the
  // kind of action that should leave an audit trail in a ledger app.
  deletedAt        DateTime?
  // 🔒 V19-007: Idempotency — prevents duplicate payments from offline sync replays.
  // Same pattern as Transaction.clientMutationId.
  clientMutationId String?   @unique

  // 🔒 V17 Audit Phase 6: Bank reconciliation — matched bank transactions
  bankTransactions BankTransaction[]

  // 🔒 AUDIT C5: which bills this payment settles. Empty = held on account
  // (an advance), which is legitimate — shopkeepers take money before billing.
  allocations PaymentAllocation[]

  /*
   * GST rate on an advance receipt. NULL = no GST due on it.
   *
   * Advances for GOODS are exempt (Notification 66/2017); advances for SERVICES
   * are taxable the moment the money arrives, and must be declared in GSTR-1
   * Table 11A then released in 11B when the invoice is raised. Set the rate and
   * this receipt carries a liability; leave it NULL and it does not.
   *
   * Deliberately one column and not a rate plus an "is service" flag, which
   * could contradict each other. See the migration note.
   */
  advanceGstRate Float?

  // ⚡ PERFORMANCE (Audit fix Phase 5): Indexes on foreign keys + hot query
  // patterns. Without these, every payment query does a full table scan.
  @@index([userId, date])
  @@index([partyId, date])
  // 🔒 V15 M-3: Partial index for the common "active payments for this party"
  // query — smaller + faster than a full index because it excludes deleted rows.
  @@index([userId, partyId, deletedAt])
}

// ==================== PAYMENT ALLOCATION (C5) ====================
// 🔒 AUDIT C5: links a Payment to the specific bill(s) it settles.
//
// THE DEFECT THIS FIXES: a "Settle" payment reduced the PARTY balance but no
// bill knew about it, so an invoice kept displaying its original amount as due
// forever. Party outstanding and the sum of bill dues disagreed permanently,
// from the first partial payment onward. Worse, the stale "Due" invited the
// shopkeeper to collect that amount again — and nothing would have stopped it,
// because settling a bill for exactly what it claims to owe looks correct.
//
// A bill's true due is now:
//     totalAmount − paidAmount − Σ(allocations)
//
// WHY A SEPARATE TABLE rather than a paidAmount bump on the Transaction:
// the allocation is a FACT about a specific payment settling a specific bill.
// Folding it into paidAmount would lose which payment did it, making a payment
// impossible to reverse cleanly and leaving disputes unanswerable ("you say I
// paid — against what?").
model PaymentAllocation {
  id            String   @id @default(cuid())
  userId        String // denormalised for tenant-scoped queries + indexes
  paymentId     String
  transactionId String
  amount        Int // paise, like every other money column
  createdAt     DateTime @default(now())

  // Deleting a payment removes its allocations: the money never arrived, so
  // the bills it was covering must go back to being due.
  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Transactions are SOFT-deleted, never hard-deleted, so no cascade here —
  // the allocation must survive to keep the audit trail answerable.
  transaction Transaction @relation(fields: [transactionId], references: [id])

  // One row per (payment, bill). Re-allocating updates rather than duplicating,
  // which also makes an offline replay idempotent.
  @@unique([paymentId, transactionId])
  // "What has been settled against this bill?" — the hot read behind every
  // due calculation.
  @@index([userId, transactionId])
  @@index([paymentId])
}

// ==================== APP SETTINGS (per user) ====================
model Setting {
  /*
   * Composition scheme registration. NULL = the regular scheme.
   *
   * A CATEGORY rather than a boolean: the rate follows from it (1% trader or
   * manufacturer, 5% restaurant, 6% services), and a boolean plus a separate
   * rate could contradict each other. See migration 20260809000002.
   */
  compositionCategory String?
  /** When the shop entered the scheme — returns before this stay regular. */
  compositionFrom     DateTime?

  id                   String    @id @default(cuid())
  userId               String    @unique // one setting per user
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName             String    @default("My Shop")
  ownerName            String?
  address              String?
  phone                String?
  gstin                String?
  state                String?
  email                String?
  currency             String    @default("INR")
  language             String    @default("en")
  // Privacy: when true, profit figures are hidden from all UI (dashboard,
  // ledger, transaction detail). Data is still calculated and stored —
  // only the display is hidden. Owner controls this; staff inherits.
  hideProfit           Boolean   @default(false)
  // 🔒 V12: When true, the sale grand total is rounded to the nearest rupee
  // (Indian invoice norm) and the adjustment is stored in Transaction.roundOff.
  roundOffEnabled      Boolean   @default(false)
  // AI Bill Scanner output language: 'original' (keep bill language) | 'en' | 'hi' | 'ta' | 'gu' | 'mr' | 'bn' | 'te' | 'kn' | 'ml' | 'pa'
  scanLang             String    @default("original")
  // AI Voice Entry language: 'original' (keep spoken language, don't translate) | 'en' | 'hi' | 'ta' | 'gu' | 'mr' | 'bn' | 'te' | 'kn' | 'ml' | 'pa'
  // Controls BOTH the speech-recognition locale (e.g. mr-IN) AND the parsed
  // output language. 'original' listens in hi-IN (default) and keeps the
  // spoken language in the parsed result (no English translation).
  voiceLang            String    @default("original")
  // 🔒 V11 STOCK POLICY: Controls whether sales can push stock below 0.
  //   'block' (default) — sale is REJECTED if it would push stock negative.
  //                       The user must record a purchase first or toggle to 'allow'.
  //   'allow'            — sale goes through with a warning (kirana workflow:
  //                       sell first, record purchase later). The warning shows
  //                       in the UI but does NOT block.
  // This field is per-shop (lives on Setting, one per user). The user can
  // toggle it in Settings → "Allow overselling (kirana mode)".
  stockPolicy          String    @default("block")
  // V17-Ext 5.4: Shopkeeper's UPI VPA for udhaar collection links.
  // Used to generate upi://pay?pa=... deep-links in WhatsApp reminders.
  // null = no UPI ID configured (the reminder sends without a pay link).
  upiId                String?
  // 🔒 V17-Ext §5.1: Period lock (financial-year lock). When set, NO writes
  // (create/edit/delete/restore) are allowed to transactions or payments dated
  // on or before this date. Protects filed GST returns from silent alteration.
  // null = no lock (the default — every shop starts unlocked).
  lockedUntil          DateTime?
  // 🔒 V26 R3 (Phase 5): Resume marker for interrupted restores.
  // When a restore starts, this is set to the incoming restoreSessionId (uuid
  // from the client). On completion (success or fail), it is cleared.
  // If a restore is interrupted (timeout, network drop, function kill), the
  // next retry sees a non-empty shop BUT a matching restoreSessionId → resume
  // (skip rows whose invoiceNo+date+totalAmount already exist) instead of the
  // old behavior (assertShopIsEmpty fails → user stuck with partial books and
  // no way forward except destructive account-reset).
  // null = no restore in progress (the default).
  lastRestoreSessionId String?
  // 🔒 PDF Redesign Spec Part 3 §2: Shop logo URL (Cloudinary secure_url).
  // Rendered at 18×18 mm in the brand band of every invoice PDF. null = no
  // logo uploaded (the brand band shows just the shop name + details). The
  // logo is uploaded via /api/settings/logo (which uses uploadBillImage) and
  // stored here so it appears on every invoice without re-uploading.
  logoUrl              String?

  // 🐛 UI/UX Phase 2: Business card redesign fields
  // cardDesign stores the user's chosen design ID from the design registry
  // (src/lib/business-card-designs.ts). null = default design ("saffron-classic").
  // cardSlug is a unique URL-safe slug for the public business card page
  // (/card/[slug]). null = no public card. Auto-generated from shopName on first
  // card view if not set.
  cardDesign String?
  cardSlug   String? @unique

  // 🎨 2026-08-04: the card carries its own details, separate from the profile.
  //
  // WHY THE CARD DOES NOT JUST READ THE PROFILE. The profile is the shop's
  // legal identity — the name and address that go on a GST invoice. The card is
  // marketing. A shopkeeper registered as "SHREE SIDDHIVINAYAK TRADING CO." who
  // wants "Siddhivinayak Stores" on the card must not have to falsify the
  // invoice to get it, and a shop with a landline on the invoice may want a
  // mobile on the card. Rahul asked for exactly this: a toggle for "pre-filled
  // from profile" or "manual entry".
  //
  // cardMode = 'profile' (default) — every field below is IGNORED and the card
  //   tracks the profile live, so fixing a typo in Settings fixes the card too.
  // cardMode = 'manual' — a non-null field below WINS; a null one still falls
  //   back to the profile, so switching to manual never blanks the card.
  //
  // The values are kept even in 'profile' mode: toggling back and forth must
  // not destroy what the shopkeeper typed. Nothing here is ever cleared on
  // mode change — only the shopkeeper editing a field changes a field.
  // 📄 How bills are sent — 'smart' | 'image' | 'pdf'.
  //
  // 'smart' (the default) picks by bill length: a short bill goes as a picture,
  // which opens straight in a WhatsApp chat, and a long one as a PDF, because
  // WhatsApp downsamples images to ~1600px on the longest side and a tall bill
  // ends up squeezed too narrow to read. See lib/document-delivery.
  //
  // A preference rather than a prompt: a shopkeeper billing forty customers a
  // day should not answer forty format questions.
  // 📄 Which invoice look this shop uses — see src/lib/invoice-themes.ts.
  // One theme drives the WhatsApp picture, the link page and the PDF, so a
  // shop's bill and its payment page cannot look like two businesses.
  invoiceTheme String @default("classic")

  docSendFormat String @default("smart")

  // 📄 Whether a shareable LINK goes out alongside the bill.
  //
  // OFF BY DEFAULT, deliberately. A link puts a page carrying a customer's bill
  // on the public internet behind an unguessable address, and that is a choice
  // a shopkeeper makes rather than one made for them. Rahul asked for the
  // toggle by name.
  docShareLink Boolean @default(false)

  cardMode String @default("profile")

  // Which mark the card prints: 'auto' | 'logo' | 'monogram'.
  //
  // The artwork has ONE slot for a mark, so this is either/or — the uploaded
  // logo or the derived initials, never both.
  //
  // ⚠️ IT MUST NOT BE `logoUrl` THAT DECIDES. `Setting.logoUrl` is shared with
  // the invoice PDF, where the logo prints in the brand band. A shopkeeper who
  // wants letters on their visiting card but their logo on their invoices would
  // otherwise have to delete the logo, which silently strips it from every
  // invoice they issue. This is a card-only preference; the file stays put.
  //
  // 'auto' (default) — logo when one is uploaded, initials when not. That is
  // what a shop expects without touching anything, and it means uploading a
  // logo is enough to see it on the card.
  cardMark           String   @default("auto")
  // Typeface per element of the card — see src/lib/monogram-fonts.ts.
  // null = that element keeps the app's default face.
  //
  // Four columns rather than one because Rahul asked for the choice to be
  // per-element: "when they choose for shop name only shop name fonts should
  // be changed. when they choose for tagline then it should change the
  // tagline." A single column cannot express a copperplate monogram over a
  // plain, readable address.
  //
  // cardFontId is the LOGO/monogram face and predates the others; it keeps its
  // name so existing rows keep their chosen mark.
  cardFontId         String?
  cardShopFontId     String?
  cardTaglineFontId  String?
  cardContactFontId  String?
  cardShopName       String?
  cardOwnerName      String?
  cardTagline        String?
  cardPhone          String?
  cardEmail          String?
  cardAddress        String?
  cardGstin          String?
  /**
   * Previous financial year's aggregate turnover, in PAISE, as declared by the
   * shopkeeper. Optional override for GSTR-1's `gt`.
   * gt is normally computed from the app's own prior-FY transactions, which is
   * right for a shop that has used the app all along. A shop that traded for
   * years on paper and started here in the middle of a year has no such history,
   * so the computed figure reads 0 and understates them.
   * That is not cosmetic: turnover decides HSN digit requirements under
   * Notification 78/2020 (4 digits below ₹5 crore, 6 above) and e-invoicing
   * applicability. An app that believes a ₹6-crore business turned over nothing
   * cannot warn them they owe 6-digit HSN.
   * Null means "not declared — compute it", so existing shops are unaffected.
   * REGISTERED in MONEY_COLUMNS (prisma-money-extension): an unregistered money
   * column reads back as raw paise and is exactly the 100x class of bug that
   * file exists to prevent.
   */
  priorFyTurnover    Int?
  /**
   * Has this shop's turnover ever crossed ₹5 crore in a year since 2017-18?
   * Three-valued on purpose. NULL means "never asked" and is not the same as
   * false: one means the app should ask, the other means it should stay quiet.
   * Collapsing them would either nag a shop that has already answered, or
   * silently treat an unanswered shop as exempt.
   * Declared rather than computed because the rule (Notification 10/2023) tests
   * ANY financial year from 2017-18, does not lapse if turnover later falls,
   * and aggregates every GSTIN under the PAN. Each of those is information this
   * app does not have: years before it existed, other registrations, and a
   * liability that outlives the figures that created it.
   */
  eInvoiceApplicable Boolean?
}

// ==================== ANNOUNCEMENTS (broadcast messages) ====================
model Announcement {
  id        String    @id
  title     String
  message   String
  type      String    @default("info") // info | warning | success | promo
  link      String?
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([isActive, startsAt, endsAt])
}

// ==================== FEATURE FLAGS (remote kill switches) ====================
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  label       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([enabled])
}

// ==================== REFERRALS (refer 3 = 1 year free Pro) ====================
model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String?   @unique
  code        String    @unique
  status      String    @default("pending") // pending | completed | rewarded
  rewardGiven Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  referrer    User      @relation("Referral_referrerIdToUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User?     @relation("Referral_referredIdToUser", fields: [referredId], references: [id], onDelete: SetNull)

  @@index([referredId])
  @@index([referrerId, status])
}

// ==================== SUBSCRIPTIONS (Razorpay payments) ====================
model Subscription {
  id             String   @id
  userId         String
  plan           String // pro | elite
  status         String   @default("active") // active | cancelled | expired
  amount         Int
  paymentMode    String   @default("razorpay")
  paymentId      String?  @unique // 🔒 IDEMPOTENCY: unique constraint prevents duplicate subscriptions from double-submitted payment verifications (Audit fix Phase 1.4)
  subscriptionId String?
  startDate      DateTime @default(now())
  endDate        DateTime
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
}

// ==================== USAGE TRACKING (plan limits) ====================
model UsageTracking {
  id           String   @id @default(cuid())
  userId       String
  month        String // YYYY-MM format
  transactions Int      @default(0)
  aiScans      Int      @default(0)
  voiceParses  Int      @default(0)
  products     Int      @default(0)
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId, month])
}

// ==================== PASSWORD RESET TOKENS (C2 audit fix) ====================
// 🔒 SECURITY: Reset tokens are now stored in the DB (not in-memory Map) so
// they survive serverless cold starts and are shared across instances.
// Only the SHA-256 hash is stored — never the raw token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String // the user's email (lowercased)
  tokenHash String    @unique // SHA-256 hash of the raw token (never store raw)
  expiresAt DateTime // 1 hour from creation
  usedAt    DateTime? // null = not yet used; set when consumed (single-use)
  createdAt DateTime  @default(now())

  @@index([email, expiresAt])
  @@index([tokenHash])
}

// ==================== AUDIT LOG (security & compliance) ====================
// Track every important action: logins, data exports, deletes, role changes.
// Used for: security forensics, compliance (DPDP Act), dispute resolution.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String? // user who performed the action (null = unauthenticated attempt)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // login_success | login_failure | logout | data_export | data_delete | role_change | settings_update | etc.
  entityType String? // product | party | transaction | setting | user | staff
  entityId   String? // ID of the affected entity
  ip         String? // IP address of the actor
  userAgent  String? // browser/device info
  metadata   Json? // any extra context (what changed, what was exported, etc.)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ==================== FIELD-LEVEL AUDIT TRAIL ====================
// V17-Ext 5.1: Every edit to a transaction/payment records who changed
// what field from what to what. This lets you reconstruct what the books
// said at any point in time — fraud defense + court-admissible.
model FieldChangeLog {
  id              String   @id @default(cuid())
  userId          String // shop owner (tenant scope)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType      String // transaction | payment
  entityId        String
  fieldName       String // e.g. totalAmount, paidAmount, date
  oldValue        String? // JSON-serialized old value (null = was empty)
  newValue        String? // JSON-serialized new value (null = set to null)
  changedByUserId String? // who made the change (owner or staff). No FK to avoid modifying User model.
  // 🔒 2026-08-04 (Phase 7 audit): the admin email when this change was made by
  // a support admin logged in AS the shopkeeper. Null for the shopkeeper's own
  // edits, which is every existing row.
  //
  // Without it, changedByUserId held the SHOPKEEPER's id for an edit an admin
  // made, so this table — described above as fraud defence and court-admissible
  // — attributed a support action to the account holder. `impersonatedBy` was
  // carried on the session but read only to render a UI banner; it reached
  // nothing that is stored.
  impersonatedBy  String?
  createdAt       DateTime @default(now())

  @@index([userId, entityType, entityId, createdAt])
  @@index([entityId, createdAt])
}

// ==================== GST RETURN (GSTR-3B MONTHLY SNAPSHOT) ====================
// V17-Ext Tier 3: Stores a monthly GSTR-3B snapshot so the user can see
// "what did I file for July?" without recomputing. One snapshot per user
// per month (unique on userId + monthYear). Fields mirror the GSTR-3B form
// sections: 3.1 (outward), 3.1(d) (RCM), 3.1(c) (nil/exempt/non-GST),
// 3.2 (interstate B2C), 4 (ITC), 5 (exempt inward), 6.1 (net payable).
model GstReturn {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthYear     String // "072026" (MMYYYY) — matches GSTR-1 fp format
  periodStart   DateTime // IST first day of month
  periodEnd     DateTime // IST last day of month
  filingStatus  String    @default("draft") // draft | filed
  filedAt       DateTime?
  filedByUserId String? // who marked it as filed

  // Section 3.1(a): Outward taxable supplies (regular sales)
  outwardTaxableValue Int @default(0)
  outwardCgst         Int @default(0)
  outwardSgst         Int @default(0)
  outwardIgst         Int @default(0)

  // Section 3.1(d): RCM (reverse charge) outward liability
  rcmTaxableValue Int @default(0)
  rcmCgst         Int @default(0)
  rcmSgst         Int @default(0)
  rcmIgst         Int @default(0)

  // Section 3.1(c): Nil-rated + exempt + non-GST outward
  nilRatedValue Int @default(0)
  exemptValue   Int @default(0)
  nonGstValue   Int @default(0)

  // Section 4(a): ITC (input tax credit) from purchases
  itcTaxableValue Int @default(0)
  itcCgst         Int @default(0)
  itcSgst         Int @default(0)
  itcIgst         Int @default(0)

  // 🔒 V17 Audit §4.3: Credit/Debit Note breakdown (computed but not stored before).
  // Storing these helps audit/dispute resolution — the filed snapshot now has
  // the full CDN adjustment, not just the net tax payable.
  creditNoteTaxableValue Int @default(0)
  creditNoteCgst         Int @default(0)
  creditNoteSgst         Int @default(0)
  creditNoteIgst         Int @default(0)
  debitNoteTaxableValue  Int @default(0)
  debitNoteCgst          Int @default(0)
  debitNoteSgst          Int @default(0)
  debitNoteIgst          Int @default(0)

  // Section 5: Exempt inward supplies
  exemptInwardValue Int @default(0)

  // Section 3.2: Inter-state B2C supplies (unregistered, any amount)
  interstateB2cTaxableValue Int @default(0)
  interstateB2cIgst         Int @default(0)

  // Section 6.1: Net tax payable (output + RCM - ITC)
  netTaxPayable Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, monthYear])
  @@index([userId, periodStart])
}

// ==================== GSTR-1 SNAPSHOT (Phase 3) ====================
// 🔒 V17 Audit Phase 3: Stores a monthly GSTR-1 snapshot so the user can see
// "what did I file for July?" without recomputing. One snapshot per user per
// month (unique on userId + monthYear). Stores the portal-ready JSON for audit
// + a filed/draft status + the filed netTaxPayable for drift detection.
model Gstr1Snapshot {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthYear     String // "072026" (MMYYYY) — matches GSTR-1 fp format
  periodStart   DateTime // IST first day of month
  periodEnd     DateTime // IST last day of month
  filingStatus  String    @default("draft") // draft | filed
  filedAt       DateTime?
  filedByUserId String? // who marked it as filed

  // The portal-ready JSON (all 8 sections: B2B, B2CL, B2CS, CDNR, CDNUR, HSN, NIL, DOC)
  // Stored as Json so the exact filed return can be reproduced for audit/dispute.
  rawJson Json?

  // Summary totals (for quick display without parsing rawJson)
  totalTaxableValue Int @default(0)
  totalOutputTax    Int @default(0) // CGST + SGST + IGST
  totalInvoiceCount Int @default(0)
  totalCreditNotes  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, monthYear])
  @@index([userId, periodStart])
}

// ==================== BANK RECONCILIATION (Phase 6) ====================
// 🔒 V17 Audit Phase 6: Stores imported bank statement transactions and
// matches them against recorded payments (cash/UPI/card/bank mode).
// Makes the app the source of truth for cash, not just credit.
//
// Flow:
//   1. User downloads a bank statement CSV from their bank/UPI app
//   2. Uploads it here → BankStatement (header) + BankTransaction (rows)
//   3. Auto-match: bank transactions ↔ recorded payments (amount + date ±2 days)
//   4. Manual match/unmatch for edge cases
//   5. Reconciled = matched bank txns; Unreconciled = unmatched (investigate)

model BankStatement {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName        String // e.g. "HDFC", "SBI", "ICICI"
  accountNumber   String? // last 4 digits (for display)
  statementPeriod String? // e.g. "Jul 2026"
  importedAt      DateTime @default(now())
  totalCredits    Int      @default(0) // money in
  totalDebits     Int      @default(0) // money out
  txnCount        Int      @default(0)
  matchedCount    Int      @default(0) // auto-matched on import
  rawCsv          String? // original CSV (for audit/re-import)
  // 🔒 V26 R6 (Phase 5): sha256 of the trimmed CSV. Unique per user → catches
  // exact-duplicate imports (double-click, concurrent tab, queue replay) via
  // a database constraint, not check-then-act. Was: 200-char prefix match
  // (false positives on banks with fixed header blocks; false negatives on
  // overlapping date ranges — every overlapping row imported twice).
  csvHash         String   @default("")

  transactions BankTransaction[]

  @@unique([userId, csvHash])
  @@index([userId, importedAt])
}

model BankTransaction {
  id              String        @id @default(cuid())
  bankStatementId String
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  userId          String // denormalized for direct querying
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime // transaction date (as shown in bank statement)
  description String // bank description (e.g. "UPI/Rahul Traders/1234")
  amount      Int // positive = credit (money in), negative = debit (money out)
  balance     Int? // running balance (if provided by bank)

  // 🔒 V26 R6 (Phase 5): sha256 of `${userId}|${date.toISOString().slice(0,10)}|${description.trim()}|${amount}`.
  // Unique per user → catches per-row duplicates (overlapping statements
  // imported twice = same row hash → skipDuplicates). Was: NO per-row dedup
  // at all → "last 3 months" downloaded in March, then again in April:
  // different first row → both statements import → every overlapping row
  // imported twice, doubling the recon workload and producing bogus unmatched rows.
  rowHash String @default("")

  // Matching status
  matchStatus          String       @default("unmatched") // unmatched | matched | ignored
  matchedPaymentId     String? // FK to Payment (if matched)
  matchedPayment       Payment?     @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedTransactionId String? // FK to Transaction (if matched to a sale/purchase)
  matchedTransaction   Transaction? @relation("BankReconMatch", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  matchMethod          String? // auto | manual (how the match was made)
  matchConfidence      Float? // 0-1 (auto-match confidence score)

  createdAt DateTime @default(now())

  @@unique([userId, rowHash])
  @@index([userId, date])
  @@index([bankStatementId])
  @@index([matchStatus])
}

// ==================== GSTR-2B IMPORT (ITC Reconciliation) ====================
// V17-Ext Tier 3: Stores a monthly GSTR-2B import from the GST portal.
// The user downloads the 2B JSON from the portal and uploads it here.
// We reconcile it against their purchase transactions to determine:
//   - Matched ITC (in both books and 2B = eligible to claim)
//   - Deferred ITC (in books but not in 2B = supplier hasn't filed yet)
//   - Missing purchases (in 2B but not in books = investigate)
model Gstr2bImport {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthYear     String // "072026" (MMYYYY)
  filingPeriod  String? // GST portal's fp field
  supplierGstin String? // taxpayer's own GSTIN (from the 2B file)
  importedAt    DateTime        @default(now())
  rawJson       Json? // full 2B JSON from portal (for audit/re-import)
  invoiceCount  Int             @default(0)
  taxableTotal  Int             @default(0)
  igstTotal     Int             @default(0)
  cgstTotal     Int             @default(0)
  sgstTotal     Int             @default(0)
  invoices      Gstr2bInvoice[]

  @@unique([userId, monthYear])
  @@index([userId, monthYear])
}

model Gstr2bInvoice {
  id              String       @id @default(cuid())
  gstr2bImportId  String
  gstr2bImport    Gstr2bImport @relation(fields: [gstr2bImportId], references: [id], onDelete: Cascade)
  userId          String // denormalized for tenant-scoped queries without join
  supplierGstin   String // ctin from 2B (supplier's GSTIN)
  invoiceNumber   String // inum from 2B (supplier's invoice number)
  invoiceDate     String? // idt from 2B (invoice date, raw string from portal)
  taxableValue    Int          @default(0)
  igst            Int          @default(0)
  cgst            Int          @default(0)
  sgst            Int          @default(0)
  totalAmount     Int          @default(0)
  isReverseCharge Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([gstr2bImportId])
  @@index([userId, supplierGstin, invoiceNumber])
  @@index([userId])
}

// ==================== AI SCAN COMPARISONS ====================
// Stores results of side-by-side AI provider tests. Each record is one
// bill image scanned by 1-3 providers (Gemini, OpenAI, Groq). Admins use
// the /settings/ai-comparison page to compare accuracy and pick the best.
model ScanComparison {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The bill image that was scanned
  imageName    String? // filename or label, if user provided one
  imagePreview String // base64 thumbnail (max ~50KB) for display in history

  // Bill type the user said it was
  billType String @default("purchase") // sale | purchase

  // Results from each provider (null if that provider wasn't tested)
  geminiResult Json? // { success, parsed, error, durationMs, tokensUsed }
  openaiResult Json?
  groqResult   Json?

  // Ground truth (what the user manually entered as the correct answer)
  groundTruth Json? // { sellerName, totalAmount, itemsCount, items: [...] }

  // Computed scores per provider (0-100, null if not tested or no ground truth)
  geminiScore Float?
  openaiScore Float?
  groqScore   Float?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ==================== AI USAGE LOG (cost tracking) ====================
// Every AI call (scan-bill, voice-parse) gets logged here with exact token
// counts and calculated cost. Used by the /settings/ai-usage dashboard to
// show the founder exactly how much each feature costs to run.
model AiUsageLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature  String // 'scan-bill' | 'voice-parse' | 'scan-compare'
  provider String // 'gemini' | 'openai' | 'groq' | 'vlm' | 'zai-sdk'
  model    String // e.g. 'gemini-2.5-flash', 'llama-4-scout-17b-16e-instruct'

  // Token counts from the AI provider's response
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  // Cost in INR (calculated at time of call using current pricing)
  // Stored per-call so historical costs are preserved even if prices change
  costInr Int @default(0)

  // Performance + result
  durationMs   Int     @default(0)
  success      Boolean @default(true)
  errorMessage String? // null if success, error text if failed

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
  @@index([feature, provider, createdAt])
}

